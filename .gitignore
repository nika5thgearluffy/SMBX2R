# Keep the worlds folder, but don't include anything that's not the default games to choose from
/data/worlds/*
!.gitkeep
!Mario Challenge
!The Invasion 1
!The Invasion 2
!The Princess Cliche

# Ignore everything in the user files folder except the do not delete file and folders like "!screenshots" and "!gif-recordings" (But exclude screenshots and GIF recordings)
/!user-files/*
!DO_NOT_DELETE!.txt
!\!screenshots
!\!screenshots/.gitkeep
/!user-files/\!screenshots/*
!\!gif-recordings
!\!gif-recordings/.gitkeep
/!user-files/\!gif-recordings/*
# Ignore everything in the logs folder except ".gitkeep"
/data/logs/*
!.gitkeep

# Ignore other misc LunarLuna build files that's used for debugging
/data/LunaDll.exp
/data/LunaDll.lib
/data/LunaDll.map
/data/LunaDll.pdb
/data/LunaLoader.iobj
/data/LunaLoader.ipdb
/data/LunaLoader.pdb
/data/LunaDll.ilk

# Ignore editor files that's set by the user
data/PGE/settings/pge_editor.ini

# Ignore any other configs on the editor
data/PGE/configs/*
!SMBX2R-Integration
data/PGE/settings/pge_editor_config_*.ini

# Ignore any save files on default episodes
data/worlds/The Princess Cliche/*.sav
data/worlds/The Princess Cliche/*-ext.dat
data/worlds/The Invasion 1/*.sav
data/worlds/The Invasion 1/*-ext.dat
data/worlds/The Invasion 2/*.sav
data/worlds/The Invasion 2/*-ext.dat
data/worlds/Mario Challenge/*.sav
data/worlds/Mario Challenge/*-ext.dat
data/worlds/Mario Challenge/data.json
data/worlds/Mario Challenge/progress.json

# Ignore any configs the engine uses
data/config.dat
